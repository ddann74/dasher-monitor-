<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location: trip lifecycle / GPS logging -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- General-driving auto-start: detects "in vehicle" motion so
         monitoring can start even if Dasher is never opened at all. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Foreground service (always-on trip tracking) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Opt-in screen recording during a trip (docs/screen_recording/PRD.md).
         Required for Android 14+'s stricter per-type foreground service
         declarations - TripForegroundService's own manifest entry below
         declares the matching foregroundServiceType. The actual capture
         grant (MediaProjection) is a separate, per-session Activity-result
         consent dialog Android itself shows - this manifest permission
         only allows the SERVICE to run with that grant, it does not grant
         screen capture by itself. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Bluetooth assist (car connect/disconnect) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Offer / message capture -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <!-- Accessibility service: reads UI text after offer acceptance -->
    <!-- (declared via BIND_ACCESSIBILITY_SERVICE on the service itself) -->

    <!-- Emergency SMS alert (v2.3 roadmap) -->

    <!-- Nominatim geocoding (occasional network use, otherwise 100% offline) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Vibrate cues for the Smart Score label (Excellent/Good/Fair/Poor),
         implemented in HapticFeedback.vibrateForLabel. Stale comment fixed
         2026-08-23: this previously said "(v3.2 roadmap)" as if unbuilt,
         same staleness class as the fuel-cost README bullet. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Floating overlay bubble for arrival instructions (Zero Interaction While Driving) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Battery optimization exemption: without this, aggressive OEM
         battery managers (Samsung, Xiaomi, etc.) can kill the always-on
         foreground service despite it being a foreground service. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lets BootAndUpdateReceiver log reboots to the diagnostic log,
         directly relevant to investigating OEM battery killer behavior,
         since some phones reset battery optimization exemptions after a
         reboot without telling you. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Required on Android 13+ for ANY notification to show at all,
         including the persistent status notification and the new
         watchdog alert. HONEST GAP: only the manifest declaration is
         here; there's no runtime request flow built for this yet
         (same category as the other permission flows in
         PermissionsActivity), so on Android 13+ this may need to be
         granted manually via system Settings until that's built. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required so the auto-launch-Dasher-for-a-new-offer notification
         (AppNotificationListenerService.launchDasherApp) can reliably
         start Dasher's Activity from this background service via
         setFullScreenIntent(), one of Android's real Background
         Activity Launch exemptions, unlike a bare startActivity() call.
         On Android 14+ the user can revoke this in Settings, in which
         case it falls back to a normal tappable notification instead of
         auto-launching; see launchDasherApp's honesty note. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".DasherMonitorApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.DasherMonitor">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The six category screens the main screen's buttons were split
             into, since previously 23 buttons were stacked in one long
             scroll with no grouping at all. Each gets its own distinct
             theme color for quick visual recognition. -->
        <activity android:name=".TripHistoryActivity" android:exported="false"
            android:theme="@style/Theme.DasherMonitor.TripHistory"
            android:parentActivityName=".MainActivity" />
        <!-- docs/location_profitability_map/PRD.md (driver backlog #1):
             a sub-screen of Trip History, reuses its theme rather than
             a new color. -->
        <activity android:name=".LocationProfitabilityMapActivity" android:exported="false"
            android:theme="@style/Theme.DasherMonitor.TripHistory"
            android:parentActivityName=".TripHistoryActivity" />
        <activity android:name=".TrustedContactsActivity" android:exported="false"
            android:theme="@style/Theme.DasherMonitor.TrustedContacts"
            android:parentActivityName=".MainActivity" />
        <activity android:name=".CannedRepliesActivity" android:exported="false"
            android:theme="@style/Theme.DasherMonitor"
            android:parentActivityName=".PermissionsActivity" />
        <activity android:name=".PermissionsActivity" android:exported="false"
            android:theme="@style/Theme.DasherMonitor.Permissions"
            android:parentActivityName=".MainActivity" />
        <activity android:name=".DataManagementActivity" android:exported="false"
            android:theme="@style/Theme.DasherMonitor.DataManagement"
            android:parentActivityName=".MainActivity" />
        <activity android:name=".DiagnosticsActivity" android:exported="false"
            android:theme="@style/Theme.DasherMonitor.Diagnostics"
            android:parentActivityName=".MainActivity" />
        <activity android:name=".DeveloperTestingActivity" android:exported="false"
            android:theme="@style/Theme.DasherMonitor.DeveloperTesting"
            android:parentActivityName=".MainActivity" />

        <!-- Foreground service: GPS logging, trip state machine, and
             (opt-in, see docs/screen_recording/PRD.md) screen recording.
             Android allows multiple foregroundServiceType values on one
             service, pipe-separated, declaring the UNION of everything
             this service might ever need. CONFIRMED REAL BUG, fixed in
             TripForegroundService.java (see
             startForegroundLocationOnly()'s own doc): declaring both
             types here is NOT enough on its own. Each individual
             startForeground() call must explicitly request only the
             type(s) relevant to that call via the 3-arg overload, or
             Android 14 implicitly requests ALL declared types (including
             mediaProjection, with no active grant) on every single
             startForeground() call, crashing the service on every plain
             GPS-only start regardless of whether screen recording is
             even enabled. Driver-reported and reproduced: disabling
             location permission (which skips MainActivity's own
             startForegroundService call entirely) stopped the crash. -->
        <service
            android:name=".TripForegroundService"
            android:foregroundServiceType="location|mediaProjection"
            android:exported="false" />

        <!-- Captures Dasher offer + message notifications -->
        <service
            android:name=".AppNotificationListenerService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Reads screen text after offer acceptance for 100%-accurate address -->
        <service
            android:name=".DasherAccessibilityService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Logs reboots and app updates to the diagnostic log; see
             BootAndUpdateReceiver's class doc for why this matters for
             OEM battery killer investigation. -->
        <receiver
            android:name=".BootAndUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Independent watchdog: alerts if monitoring appears to have
             stopped unexpectedly. Triggered by AlarmManager, which Android
             will invoke even if the main app process was killed; see
             MonitoringWatchdogReceiver's class doc for the honest limits
             of what "instant" detection actually means here. -->
        <receiver
            android:name=".MonitoringWatchdogReceiver"
            android:exported="false" />

        <!-- General-driving auto-start: receives Activity Recognition
             transition results (in-vehicle detection). -->
        <receiver
            android:name=".DrivingDetectionReceiver"
            android:exported="false" />

        <!-- Lets exported CSV files be shared via Intent.ACTION_SEND
             without exposing the app's whole file storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.drivingefficiency.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
