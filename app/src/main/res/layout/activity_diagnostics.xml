<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/diagnostics_maroon_light">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:id="@+id/apiStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:text="" />

    <Button
        android:id="@+id/testApiConnectionButton"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/test_api_connection" />

    <Button
        android:id="@+id/viewDiagnosticLogButton"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/view_diagnostic_log" />

    <Button
        android:id="@+id/viewDiagnosticArchivesButton"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/view_diagnostic_archives" />

    <Button
        android:id="@+id/copyDiagnosticLogButton"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/copy_diagnostic_log" />

    <Button
        android:id="@+id/shareDiagnosticLogButton"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/share_diagnostic_log" />

    <Button
        android:id="@+id/exportFullHistoryButton"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/export_full_history" />

</LinearLayout>
</ScrollView>
